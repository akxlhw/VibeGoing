# --- VibeGoing 配置示例：复制为 .env 后填写 ---

# 伙伴默认使用的模型（LiteLLM 格式，换引擎不换 Soul）。
# 支持任意 LiteLLM provider 字符串，例如：
#   openai/gpt-4o、anthropic/claude-sonnet-4、gemini/gemini-2.5-pro、
#   deepseek/deepseek-chat、ollama/llama3（本地）
VIBE_LLM=openai/gpt-4o

# 对应 provider 的 API Key（BYO Key，按需填写）
OPENAI_API_KEY=sk-xxxx
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# 长期记忆开关（false 可省去记忆相关的嵌入/LLM 调用）
VIBE_MEMORY=true

# 本地数据目录（Soul 文件、向量记忆库都存在这里，默认 ./.vibe）
VIBE_HOME=./.vibe

# 关闭 CrewAI 匿名遥测（本地优先原则）
OTEL_SDK_DISABLED=true
